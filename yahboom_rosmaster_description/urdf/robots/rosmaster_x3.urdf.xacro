<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       xmlns:ignition="http://ignitionrobotics.org/schema"
       name="rosmaster_x3">

  <xacro:property name="M_PI" value="3.1415926535897931" />

  <xacro:arg name="robot_name" default="rosmaster_x3"/>
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="use_gazebo" default="false"/>
  <!-- Rendering sensors (gpu_lidar, rgbd_camera) need the ogre2 pipeline, which
       the Gazebo Fortress server cannot initialise on macOS. Set false there to
       keep the robot, its links and TF while omitting those two sensors. -->
  <xacro:arg name="render_sensors" default="true"/>
  <!-- gz_ros2_control only reports joint state here; MecanumDrive owns motion.
       Activating a controller aborts the Gazebo server on macOS because
       ros2_control waits on a condition variable holding an unlocked mutex,
       which libc++ rejects. Set false to publish joint state straight from
       Gazebo instead and skip ros2_control entirely. -->
  <xacro:arg name="use_ros2_control" default="true"/>
  <!-- Which simulator the Gazebo tags target. "fortress" is the upstream
       backend. "classic" is for macOS, where Fortress cannot render sensors or
       open its GUI; Gazebo Classic can, and its CPU raycast lidar works there. -->
  <xacro:arg name="sim_backend" default="fortress"/>
  <xacro:property name="backend" value="$(arg sim_backend)"/>
  <!-- Gazebo Classic plugin suffix: conda installs .dylib on macOS, .so on Linux. -->
  <xacro:arg name="plugin_ext" default=".so"/>
  <!-- Topic planar_move drives from on the Classic backend. Fortress routes
       /cmd_vel through cmd_vel_watchdog to add per-direction drift; pointing
       this at the watchdog's output gives Classic the same treatment, while the
       default keeps planar_move on /cmd_vel when no watchdog runs. -->
  <xacro:arg name="cmd_vel_topic" default="cmd_vel"/>
  <!-- Contact parameters are supplied by the simulator motion profile. These
       defaults preserve the ideal description when xacro is expanded directly. -->
  <xacro:arg name="wheel_mu" default="1.0"/>
  <xacro:arg name="wheel_mu2" default="0.0"/>
  <xacro:arg name="wheel_slip2" default="0.0"/>
  <xacro:arg name="front_left_slip1" default="0.0"/>
  <xacro:arg name="front_right_slip1" default="0.0"/>
  <xacro:arg name="back_left_slip1" default="0.0"/>
  <xacro:arg name="back_right_slip1" default="0.0"/>

  <xacro:include filename="$(find yahboom_rosmaster_description)/urdf/mech/rosmaster_x3_base.urdf.xacro"/>
  <xacro:include filename="$(find yahboom_rosmaster_description)/urdf/mech/mecanum_wheel.urdf.xacro"/>
  <xacro:include filename="$(find yahboom_rosmaster_description)/urdf/sensors/rgbd_camera.urdf.xacro"/>
  <xacro:include filename="$(find yahboom_rosmaster_description)/urdf/sensors/lidar.urdf.xacro"/>
  <xacro:include filename="$(find yahboom_rosmaster_description)/urdf/sensors/imu.urdf.xacro"/>

  <xacro:rosmaster_x3_base
    prefix="$(arg prefix)"
    footprint_inertial="${backend == 'classic'}"/>

  <!-- fdir1 = roller grip direction in base_footprint frame via ignition:expressed_in.
       Matches the official Gazebo mecanum demo (expressed_in="chassis", same topology).
       FL/BR: grip along (1, -1, 0) — "A"-type rollers
       FR/BL: grip along (1,  1, 0) — "B"-type rollers -->
  <xacro:mecanum_wheel
    prefix="$(arg prefix)"
    side="front_left"
    x_reflect="1"
    y_reflect="1"
    fdir1="1 -1 0"
    mu="$(arg wheel_mu)"
    mu2="$(arg wheel_mu2)"
    slip1="$(arg front_left_slip1)"
    slip2="$(arg wheel_slip2)"
    simple_friction="${backend == 'classic'}"
    joint_type="${'fixed' if backend == 'classic' else 'continuous'}"/>

  <xacro:mecanum_wheel
    prefix="$(arg prefix)"
    side="front_right"
    x_reflect="1"
    y_reflect="-1"
    fdir1="1 1 0"
    mu="$(arg wheel_mu)"
    mu2="$(arg wheel_mu2)"
    slip1="$(arg front_right_slip1)"
    slip2="$(arg wheel_slip2)"
    simple_friction="${backend == 'classic'}"
    joint_type="${'fixed' if backend == 'classic' else 'continuous'}"/>

  <xacro:mecanum_wheel
    prefix="$(arg prefix)"
    side="back_left"
    x_reflect="-1"
    y_reflect="1"
    fdir1="1 1 0"
    mu="$(arg wheel_mu)"
    mu2="$(arg wheel_mu2)"
    slip1="$(arg back_left_slip1)"
    slip2="$(arg wheel_slip2)"
    simple_friction="${backend == 'classic'}"
    joint_type="${'fixed' if backend == 'classic' else 'continuous'}"/>

  <xacro:mecanum_wheel
    prefix="$(arg prefix)"
    side="back_right"
    x_reflect="-1"
    y_reflect="-1"
    fdir1="1 -1 0"
    mu="$(arg wheel_mu)"
    mu2="$(arg wheel_mu2)"
    slip1="$(arg back_right_slip1)"
    slip2="$(arg wheel_slip2)"
    simple_friction="${backend == 'classic'}"
    joint_type="${'fixed' if backend == 'classic' else 'continuous'}"/>

  <xacro:rgbd_camera
    prefix="$(arg prefix)"
    camera_name="cam_1"
    xyz_offset="0.105 0 0.05"
    rpy_offset="0 0 0"
    enable_gz_sensor="${backend == 'fortress' and '$(arg render_sensors)' in ['true', 'True', '1']}"/>

  <!-- Classic's CPU raycast starts each ray at range_min, so anything nearer is
       skipped rather than clamped. The chassis collision box spans x [-0.181,
       0.119], y +/-0.069, z [0.008, 0.205] about base_link and so encloses this
       mount, putting its furthest corner 0.2345 m away. Any range_min below
       that starts part of the sweep inside the hull and those beams return the
       robot instead of the room. Fortress renders from the visual mesh, which
       the mount clears, so it keeps the sensor's true minimum. -->
  <xacro:lidar_sensor
    prefix="$(arg prefix)"
    parent="base_link"
    frame_id="laser_link"
    xyz_offset="0.043 0 0.110"
    rpy_offset="0 0 ${M_PI}"
    min_range="${0.25 if backend == 'classic' else 0.05}"
    mesh_xyz_offset="0 0 0"
    mesh_rpy_offset="${-M_PI/2} 0 0"
    update_rate="5"
    topic_name="scan"
    enable_gz_sensor="${backend == 'fortress' and '$(arg render_sensors)' in ['true', 'True', '1']}"
    classic_sensor="${backend == 'classic'}"
    plugin_ext="$(arg plugin_ext)"/>

  <xacro:imu_sensor
    prefix="$(arg prefix)"
    parent="base_link"
    frame_id="imu"
    xyz_offset="-0.06 0.01 0.01"
    rpy_offset="0 3.1415 1.5707"
    update_rate="10.0"
    topic_name="imu/data"/>

  <!-- Gazebo Fortress simulation plugins. gz_ros2_control is read-only for
       wheel and IMU state; native MecanumDrive owns wheel velocity commands. -->
  <xacro:if value="${backend == 'classic'}">
    <gazebo>
      <!-- ODE parks resting bodies, and a parked body ignores the velocity
           planar_move sets, so the robot never starts moving. -->
      <allow_auto_disable>false</allow_auto_disable>

      <!-- Holonomic base drive. planar_move consumes linear.x, linear.y and
           angular.z, so it reproduces mecanum strafing, and it owns both /odom
           and the odom->base_footprint transform. -->
      <plugin name="planar_move" filename="libgazebo_ros_planar_move$(arg plugin_ext)">
        <ros>
          <remapping>cmd_vel:=$(arg cmd_vel_topic)</remapping>
          <remapping>odom:=odom</remapping>
        </ros>
        <update_rate>50</update_rate>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <odometry_frame>odom</odometry_frame>
        <robot_base_frame>$(arg prefix)base_footprint</robot_base_frame>
        <covariance_x>0.0001</covariance_x>
        <covariance_y>0.0001</covariance_y>
        <covariance_yaw>0.01</covariance_yaw>
      </plugin>

      <!-- No joint state publisher here: the wheels are welded on this backend,
           so there is nothing to report and robot_state_publisher emits their
           transforms on /tf_static instead. -->

    </gazebo>
  </xacro:if>

  <xacro:if value="${backend == 'fortress' and '$(arg use_gazebo)' in ['true', 'True', '1']}">
    <gazebo>
      <xacro:if value="$(arg use_ros2_control)">
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <parameters>$(find yahboom_rosmaster_gazebo)/config/ros2_control.yaml</parameters>
        </plugin>
      </xacro:if>

      <!-- Same wheel-state source as joint_state_broadcaster, published by
           Gazebo itself. ros_gz_bridge turns it into /joint_states. -->
      <xacro:unless value="$(arg use_ros2_control)">
        <plugin filename="ignition-gazebo-joint-state-publisher-system"
                name="ignition::gazebo::systems::JointStatePublisher">
          <topic>joint_states_gz</topic>
        </plugin>
      </xacro:unless>

      <plugin filename="ignition-gazebo-mecanum-drive-system"
              name="ignition::gazebo::systems::MecanumDrive">
        <front_left_joint>$(arg prefix)front_left_wheel_joint</front_left_joint>
        <front_right_joint>$(arg prefix)front_right_wheel_joint</front_right_joint>
        <back_left_joint>$(arg prefix)back_left_wheel_joint</back_left_joint>
        <back_right_joint>$(arg prefix)back_right_wheel_joint</back_right_joint>
        <wheelbase>0.16</wheelbase>
        <wheel_separation>${wheel_separation}</wheel_separation>
        <wheel_radius>0.0325</wheel_radius>
        <min_acceleration>-1.0</min_acceleration>
        <max_acceleration>1.0</max_acceleration>
      </plugin>

      <!-- Measurement-only world pose. It is bridged to /ground_truth/odom but
           its Pose_V output is intentionally not bridged into the ROS TF tree. -->
      <plugin filename="ignition-gazebo-odometry-publisher-system"
              name="ignition::gazebo::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>$(arg prefix)base_footprint</robot_base_frame>
        <dimensions>3</dimensions>
        <odom_publish_frequency>50</odom_publish_frequency>
        <odom_topic>/model/rosmaster_x3/ground_truth</odom_topic>
        <odom_covariance_topic>/model/rosmaster_x3/ground_truth_with_covariance</odom_covariance_topic>
        <tf_topic>/model/rosmaster_x3/ground_truth_pose</tf_topic>
      </plugin>
    </gazebo>
  </xacro:if>

  <!-- ros2_control joints/interfaces for the robot -->
  <xacro:include filename="$(find yahboom_rosmaster_description)/urdf/control/rosmaster_x3_ros2_control.urdf.xacro" />
  <xacro:yahboom_rosmaster_ros2_control
    prefix="$(arg prefix)"
    use_gazebo="$(arg use_gazebo)"/>

</robot>
