<?xml version="1.0" ?>
<!-- Gazebo Classic world for the macOS backend.

     Everything is defined inline rather than pulled from the Fuel model
     database, so the world loads without network access. The walls and pillars
     exist to give the lidar something to return and slam_toolbox something to
     map. -->
<sdf version="1.6">
  <world name="default">

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- A 6 x 6 m room. Walls are 0.5 m tall so the lidar at z=0.115 sees them. -->
    <model name="wall_north">
      <static>true</static><pose>0 3 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6.2 0.1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.2 0.1 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static><pose>0 -3 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6.2 0.1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.2 0.1 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static><pose>3 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 6.2 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 6.2 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static><pose>-3 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 6.2 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 6.2 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Interior obstacles: they break the room's symmetry so SLAM can localise. -->
    <model name="pillar_a">
      <static>true</static><pose>1.5 0.8 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_b">
      <static>true</static><pose>-1.2 -1.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.4 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.4 0.5</size></box></geometry>
          <material><ambient>0.8 0.3 0.2 1</ambient><diffuse>0.8 0.3 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_c">
      <static>true</static><pose>-1.8 1.6 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.9 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.9 0.5</size></box></geometry>
          <material><ambient>0.3 0.7 0.3 1</ambient><diffuse>0.3 0.7 0.3 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
